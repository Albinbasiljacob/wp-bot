# WhatsApp
BOT_NAME=MyBot
PREFIX=.
# Set to "pairing" to use an 8-digit code instead of QR
AUTH_METHOD=qr
# Only required when AUTH_METHOD=pairing
PHONE_NUMBER=15551234567

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Keep replies concise.

# RAG (optional)
RAG_ENABLED=false
RAG_BASE_URL=http://localhost:8000

# Behaviour
BOT_MODE=public
